# AI API 설정 (제약사항: 환경변수로만 관리, 하드코딩 금지)
# NVIDIA NIM — build.nvidia.com에서 API Key 발급 (무료, 신용카드 불필요)
# 발급: https://build.nvidia.com → Settings → API Keys
AI_API_KEY=nvapi-your_nvidia_nim_api_key
AI_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
AI_MODEL=meta/llama-3.1-8b-instruct

# Mock 모드 (개발/테스트용, AI 없이 템플릿 생성)
# AI_MOCK_MODE=true
